# ---------- Server ----------
PORT=3000
FRONTEND_URL=http://localhost:5173
# Public URL of THIS backend as seen from the OpenWA server (webhooks are delivered here)
PUBLIC_URL=http://host.docker.internal:3000
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Seeds the per-number HMAC secret OpenWA signs webhooks with. Long random string; don't rotate casually.
WEBHOOK_SECRET=change-me-another-long-random-string
MAX_NUMBERS_PER_USER=5

# ---------- Supabase Postgres ----------
# Supabase dashboard -> Connect -> ORM/Postgres connection string.
# Prefer the *Session pooler* string (port 5432) - it works over IPv4 and from Docker:
#   postgresql://postgres.<project-ref>:<DB-PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
# (The direct db.<ref>.supabase.co host is IPv6-only. The transaction pooler on :6543 is fine for running
#  the app, but use :5432 for the first run that creates the tables.)
DATABASE_URL=postgresql://postgres.your-project-ref:YOUR_DB_PASSWORD@aws-0-your-region.pooler.supabase.com:5432/postgres
# Supabase needs TLS. Set to false only for a local, non-TLS Postgres.
DB_SSL=true
# true = create/update tables automatically on startup (first run). Set to false afterwards.
DB_SYNCHRONIZE=true
DB_POOL_MAX=10

# ---------- OpenWA ----------
# Base URL of your OpenWA server (the /api prefix is added by the code).
OPENWA_URL=
# Sent as the `X-API-Key` header on EVERY OpenWA request. Server-side only: never expose to the frontend.
OPENWA_API_KEY=

# ---------- AI auto-reply ----------
# anthropic | openai  (openai = any OpenAI-compatible chat completions endpoint)
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-sonnet-5-5
# Only used when AI_PROVIDER=openai
AI_BASE_URL=https://api.openai.com/v1
